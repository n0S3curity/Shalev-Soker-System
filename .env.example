# ===========================================================================
#  Copy to .env and fill in every value marked CHANGE-ME.
#  The API refuses to start with placeholder secrets.
#
#  Generate strong values with:
#    openssl rand -base64 48        (or)   python -c "import secrets;print(secrets.token_urlsafe(48))"
# ===========================================================================

# ── Public address ─────────────────────────────────────────────────────────
# The exact origin the browser uses. With a Cloudflare Tunnel this is your
# public hostname. Cookies are marked Secure automatically when it is https.
PUBLIC_ORIGIN=https://surveys.example.com
ENVIRONMENT=production
LOG_LEVEL=INFO
TIMEZONE=Asia/Jerusalem

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_DB=surveys
MONGO_ROOT_USER=surveys_root
MONGO_ROOT_PASSWORD=CHANGE-ME-root-password
MONGO_APP_USER=surveys_app
MONGO_APP_PASSWORD=CHANGE-ME-app-password

# ── Sessions ───────────────────────────────────────────────────────────────
# At least 32 characters of randomness. Changing it logs everyone out.
SESSION_SECRET=CHANGE-ME-at-least-32-random-characters-long
SESSION_TTL_HOURS=12

# ── Accounts ───────────────────────────────────────────────────────────────
# Sign-in is email + password. There is no self-registration: the owner account
# below is created on first boot, and every other account is opened by an admin
# from the משתמשים screen, which issues a one-time password.
ADMIN_EMAIL=mosseriy1@gmail.com

# Optional. If set, the owner starts with this password instead of a generated
# one printed to the container log. It must still be changed at first sign-in.
# ADMIN_INITIAL_PASSWORD=

# Password policy: minimum length (a letter and a digit are always required).
PASSWORD_MIN_LENGTH=10

# Failed sign-ins before an account is locked, and for how long.
MAX_LOGIN_ATTEMPTS=6
LOCKOUT_MINUTES=15

# How long an emailed password-reset link stays valid.
RESET_TOKEN_TTL_MINUTES=60

# ── Outgoing mail (daily report + password reset links) ────────────────────
# For Gmail use an App Password (Google Account > Security > 2-Step
# Verification > App passwords). A normal account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mosseriy1@gmail.com
SMTP_PASSWORD=CHANGE-ME-gmail-app-password
MAIL_FROM=mosseriy1@gmail.com
REPORT_RECIPIENT=mosseriy1@gmail.com

# ── Uploads ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
MAX_FILES_PER_SURVEY=40

# ── Rate limits (requests/seconds) ─────────────────────────────────────────
RATE_LOGIN=10/300
RATE_API=300/60
RATE_EXPORT=10/300
RATE_UPLOAD=120/300
RATE_RESET=5/900

# ── Cloudflare ─────────────────────────────────────────────────────────────
# Trust CF-Connecting-IP for the real client address. Keep true behind the
# tunnel, set to false if you ever expose the API directly.
TRUST_CF_HEADERS=true
# Only needed if you run `docker compose --profile tunnel up`
CLOUDFLARE_TUNNEL_TOKEN=

# ── Local access / backups ─────────────────────────────────────────────────
API_LOCAL_PORT=8080
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=2
BACKUP_MINUTE=0
